# ===== JEV（TypeSafe，决策层）=====
# 推荐：先用中转站 jev-ai.pro（接口与官方一致，模型 jev-latest）
JEVAI_API_KEY=sk_jev-ai_替换成你的key
JEVAI_BASE_URL=https://jev-ai.pro/api/v1/systemone

# 官方注册地址：https://console.typesafe.ai （现开放注册，初始赠送约 $5 / 1.2 亿 token；若注册满了走上方中转站或下方 OpenRouter）
TYPESAFE_API_KEY=sk-替换成你的key

# JEV 官方接口（含 /v1/systemone 路径；想走其它网关就整段替换）
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone

# ===== JEV 替代入口：OpenRouter（typesafe/jev-1.13，无需 typesafe 注册） =====
# 注册：https://openrouter.ai → Settings → Keys 创建 key（sk-or-xxx），充值 $10 起
# 并用时把 config.yaml 的 jev.provider 改为 openrouter
OPENROUTER_API_KEY=sk-or-替换成你的key
OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/v1/decisions

# ===== LLM 生成层（默认小米 MiMo，OpenAI 兼容协议）=====
# 控制台：https://platform.xiaomimimo.com （小米账号登录）
# 创建 API Key：https://platform.xiaomimimo.com/#/console/api-keys
LLM_API_KEY=sk-替换成你的key

# 按量付费用下面这个；如果买了 Token Plan 改成 https://token-plan-cn.xiaomimimo.com/v1
LLM_BASE_URL=https://api.xiaomimimo.com/v1

# LLM_* 是首选；下面的兼容变量二选一，有哪个填哪个即可（优先级：LLM_ > MIMO_ > DEEPSEEK_）：
# MIMO_API_KEY=sk-xxx
# DEEPSEEK_API_KEY=sk-xxx          # 想换回 DeepSeek 就填这个
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== 代理（可选）=====
# 国内网络访问不了 typesafe.ai 时，取消注释并改成你的代理地址：
# HTTPS_PROXY=http://127.0.0.1:7890